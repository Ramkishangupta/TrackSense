# =============================================================================
# .gitignore — Dynamic Train ETA Prediction System (SIH 2026)
# Monorepo: React Frontend + Node.js API + Python FastAPI + PostgreSQL
# =============================================================================

# =============================================================================
# ENVIRONMENT & SECRETS (NEVER commit these)
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# =============================================================================
# FRONTEND — React + Vite (frontend/)
# =============================================================================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
frontend/.cache/

# =============================================================================
# BACKEND NODE — Express + Socket.io (backend-node/)
# =============================================================================
backend-node/node_modules/
backend-node/dist/
backend-node/build/
backend-node/logs/

# =============================================================================
# BACKEND PYTHON — FastAPI + ML (backend-python/)
# =============================================================================

# Virtual environments
backend-python/.venv/
backend-python/venv/
backend-python/env/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Distribution / build artifacts
*.egg-info/
dist/
build/
*.egg

# ML model artifacts (regenerated at runtime, can be large)
backend-python/app/models/*.pkl
backend-python/app/models/*.joblib
backend-python/app/models/*.bst
backend-python/app/models/*.txt

# LangChain / RAG vector stores (can be rebuilt from source PDFs)
backend-python/app/rag/vector_store/
backend-python/app/rag/chroma_db/
backend-python/app/rag/faiss_index/

# Jupyter / notebook checkpoints
.ipynb_checkpoints/
*.ipynb

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# =============================================================================
# DATABASE (database/)
# No compiled artifacts — SQL scripts ARE committed.
# Exclude any locally dumped data files.
# =============================================================================
database/*.dump
database/*.backup
database/*.csv
database/*.sql.bak

# =============================================================================
# LOGS & RUNTIME DATA
# =============================================================================
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# OS & EDITOR ARTIFACTS
# =============================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/extensions.json
# (keep .vscode/extensions.json if you share recommended extensions)

# JetBrains IDEs
.idea/
*.iml

# =============================================================================
# PACKAGE MANAGER LOCKS (keep these — ensures reproducible installs)
# package-lock.json → keep
# yarn.lock         → keep
# =============================================================================

# =============================================================================
# MAPLIBRE / DECK.GL TILES CACHE
# =============================================================================
*.mbtiles
tile-cache/

# =============================================================================
# MISCELLANEOUS
# =============================================================================
*.tmp
*.temp
*.bak
*.swp
*.swo
.cache/
tmp/
temp/

*.md